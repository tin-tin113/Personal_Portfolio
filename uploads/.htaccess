# Security Configuration for File Uploads Directory
# Disable PHP Script Execution entirely in this folder and all subfolders

# Turn off PHP engine if mod_php is enabled
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

# Block execution of any script extensions
<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|phps|cgi|pl|py|jsp|asp|htm|html|shtml|sh|bash|exe)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Prevent directory index listing
Options -Indexes
